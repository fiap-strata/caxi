{
  "name": "caxi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @caxi/api\" \"npm run dev -w @caxi/web\"",
    "build": "npm run build -w @caxi/domain && npm run build -w @caxi/api && npm run build -w @caxi/web",
    "test": "npm run test -w @caxi/domain && npm run test -w @caxi/api",
    "typecheck": "npm run build",
    "predev": "npm run build -w @caxi/domain",
    "pretest": "npm run build -w @caxi/domain",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs",
    "test:postgres": "DATABASE_DRIVER=postgres npm test"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.5.0"
    },
    "multer": "2.5.0",
    "body-parser": "2.4.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@vercel/blob": "2.4.0"
  }
}
