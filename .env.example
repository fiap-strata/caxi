NODE_ENV=development
PORT=3001
APP_ORIGIN=http://127.0.0.1:5173
AUTH_PROVIDER=demo
DATABASE_DRIVER=sqljs
# PostgreSQL: DATABASE_DRIVER=postgres and DATABASE_URL=postgres://caxi:caxi_local@localhost:5432/caxi
DATABASE_URL=postgres://caxi:caxi_local@localhost:5432/caxi
# Required for production. Never place these values in frontend variables.
ADMIN_KEY=replace-with-a-long-random-secret
AWS_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
SESSION_DAYS=7
# Fotos locais por padrão; na Vercel em produção, Blob é selecionado automaticamente.
# Para testar Blob localmente: PHOTO_STORAGE=blob e configure um token de um store público.
# BLOB_READ_WRITE_TOKEN= (segredo somente da API; nunca usar prefixo VITE_)
# Deploy acadêmico sem AWS/PostgreSQL: CAXI_DEMO_MODE=true, AUTH_PROVIDER=demo,
# DATABASE_DRIVER=sqljs. Usa dados temporários em /tmp; não usar para operação real.
